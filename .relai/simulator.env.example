# Required model provider credential for the LangGraph agent.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional OpenDota API key to reduce rate limiting for live tool calls.
OPENDOTA_API_KEY=

# Optional fixed draft context injected into the simulator system prompt.
# Example:
# DOTA2_COACH_DRAFT_CONTEXT_JSON={"my_faction":"radiant","my_role":"Mid","rank":5,"my_picks":[74],"enemy_picks":[1,11],"bans":[35]}
DOTA2_COACH_DRAFT_CONTEXT_JSON=
